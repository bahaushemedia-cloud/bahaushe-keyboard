c ============================================================
c  BAHAUSHE Keyboard for Keyman
c ============================================================

store(&VERSION)    "10.0"
store(&NAME)       "BAHAUSHE"
store(&COPYRIGHT)  "(c) BAHAUSHE Project"
store(&TARGETS)    "any"
store(&LAYOUTFILE) "bahaushe.keyman-touch-layout"

begin Unicode > use(main)

group(main) using keys

c DIGRAPH COMPLETION RULES
U+E001 + "h" > U+E016
U+E00C + "s" > U+E013
U+E00A + "y" > U+E00E
U+E00A + "w" > U+E010
U+E005 + "y" > U+E017
U+E005 + "w" > U+E01E
U+E004 + "w" > U+E019
U+E004 + "y" > U+E009
U+E018 + "y" > U+E01C
U+E000 + "w" > U+E015
U+E012 + "t" > U+E007

c CONSONANTS
+ "h"     > U+E000
+ "s"     > U+E001
+ "d"     > U+E002
+ "b"     > U+E003
+ U+0199  > U+E004
+ "g"     > U+E005
+ U+0253  > U+E006
+ "r"     > U+E008
+ "k"     > U+E00A
+ "j"     > U+E00B
+ "t"     > U+E00C
+ U+0257  > U+E00D
+ "n"     > U+E00F
+ "z"     > U+E011
+ "c"     > U+E012
+ "y"     > U+E014
+ "f"     > U+E018
+ "l"     > U+E01A
+ "w"     > U+E01B
+ U+01B4  > U+E01D
+ "m"     > U+E01F

c VOWELS
+ "a"     > U+E020
+ U+0101  > U+E021
+ "u"     > U+E022
+ U+016B  > U+E023
+ "o"     > U+E024
+ U+014D  > U+E025
+ "i"     > U+E026
+ U+012B  > U+E027
+ "e"     > U+E028
+ U+0113  > U+E029
